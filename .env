# YouTube API Credentials
YOUTUBE_API_KEY=tu_api_key_aqui
YOUTUBE_CLIENT_ID=tu_client_id_aqui
YOUTUBE_CLIENT_SECRET=tu_client_secret_aqui
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth/callback

# OpenAI API
OPENAI_API_KEY=tu_openai_api_key_aqui

# Google Gemini API
GEMINI_API_KEY=tu_gemini_api_key_aqui

# ElevenLabs (para voz)
ELEVENLABS_API_KEY=tu_elevenlabs_api_key_aqui

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/youtube_automation
DB_HOST=localhost
DB_PORT=5432
DB_NAME=youtube_automation
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# Redis (para colas de tareas)
REDIS_HOST=localhost
REDIS_PORT=6379

# Server Ports
PYTHON_BACKEND_PORT=8000
NODE_BACKEND_PORT=3001
FRONTEND_PORT=3000

# File Storage
VIDEO_OUTPUT_DIR=./videos
TEMP_DIR=./temp
LOGS_DIR=./logs

# Rate Limiting
YOUTUBE_API_QUOTA_LIMIT=10000
REQUESTS_PER_MINUTE=60
